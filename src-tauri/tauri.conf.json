{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tinyTD",
  "version": "0.1.0",
  "identifier": "com.tinytd.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "tinyTD",
        "width": 380,
        "height": 660,
        "minWidth": 340,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
